# Copy to .env and fill in. NEVER commit .env — the repo is public.

# --- Alpaca paper trading -------------------------------------------------
# Dashboard: app.alpaca.markets -> Home -> "API Keys" panel on the RIGHT side
# of the page (zoom out if you can't see it) -> Generate New Key.
# The secret is shown ONCE. Base URL is https://paper-api.alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Supervisor (optional) ------------------------------------------------
# A paper account issues one active key pair at a time, so leave these blank
# and the supervisor reuses the keys above. It still runs as its own process
# with its own client and connection pool, which is what keeps the kill switch
# reachable when the trader is wedged. Fill them in only if you ever have a
# second pair for this same account.
SUPERVISOR_ALPACA_API_KEY_ID=
SUPERVISOR_ALPACA_API_SECRET_KEY=

# --- Fireworks AI (LLM analyst + nightly report writer) --------------------
FIREWORKS_API_KEY=

# --- Dashboard ------------------------------------------------------------
DASHBOARD_PORT=8000
