# Copy to .env and fill in. NEVER commit .env — the repo is public.
# Alpaca paper trading (https://app.alpaca.markets — generate paper keys)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# Separate credentials for the supervisor process (own Alpaca session)
SUPERVISOR_ALPACA_API_KEY_ID=
SUPERVISOR_ALPACA_API_SECRET_KEY=

# Fireworks AI (LLM analyst + report writer)
FIREWORKS_API_KEY=

# Dashboard
DASHBOARD_PORT=8000
