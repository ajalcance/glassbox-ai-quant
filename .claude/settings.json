{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Skill",
      "Bash(uv *)",
      "Bash(python3 *)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make check*)",
      "Bash(make drill-sim*)",
      "Bash(git status*)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git stash*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore *)",
      "Bash(gh api *)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(jq *)",
      "Bash(mkdir *)",
      "Bash(ssh gbx *)"
    ],
    "deny": [
      "mcp__alpaca__place_option_order",
      "mcp__alpaca__place_stock_order",
      "mcp__alpaca__place_crypto_order",
      "mcp__alpaca__replace_order_by_id",
      "mcp__alpaca__cancel_order_by_id",
      "mcp__alpaca__cancel_all_orders",
      "mcp__alpaca__close_position",
      "mcp__alpaca__close_all_positions",
      "mcp__alpaca__exercise_options_position",
      "mcp__alpaca__do_not_exercise_options_position",
      "mcp__alpaca__update_account_config",
      "mcp__alpaca__create_locate",
      "mcp__alpaca__create_watchlist",
      "mcp__alpaca__update_watchlist_by_id",
      "mcp__alpaca__delete_watchlist_by_id",
      "mcp__alpaca__add_asset_to_watchlist_by_id",
      "mcp__alpaca__remove_asset_from_watchlist_by_id",
      "Read(.env)",
      "Edit(.env)",
      "Write(.env)",
      "Read(.env.local)",
      "Edit(.env.local)",
      "Write(.env.local)",
      "Read(.env.development)",
      "Edit(.env.development)",
      "Write(.env.development)",
      "Read(.env.staging)",
      "Edit(.env.staging)",
      "Write(.env.staging)",
      "Read(.env.production)",
      "Edit(.env.production)",
      "Write(.env.production)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/id_rsa)",
      "Read(/**/id_ed25519)",
      "Edit(/.claude/settings.json)",
      "Write(/.claude/settings.json)",
      "MultiEdit(/.claude/settings.json)",
      "NotebookEdit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Write(/.claude/settings.local.json)",
      "MultiEdit(/.claude/settings.local.json)",
      "NotebookEdit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Write(/.claude/hooks/**)",
      "MultiEdit(/.claude/hooks/**)",
      "NotebookEdit(/.claude/hooks/**)",
      "Edit(/.mcp.json)",
      "Write(/.mcp.json)",
      "MultiEdit(/.mcp.json)",
      "NotebookEdit(/.mcp.json)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "MultiEdit(~/.ssh/**)",
      "NotebookEdit(~/.ssh/**)",
      "Bash(git tag*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean*)",
      "Bash(gh release*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo *)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh ruleset*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "Bash(gh label*)",
      "Bash(gh auth*)",
      "Bash(gh gist*)",
      "Bash(npm publish*)",
      "Bash(uv publish*)",
      "Bash(*--admin*)",
      "Bash(*--no-verify*)",
      "Bash(*core.hooksPath*)",
      "Bash(*--add-label*)",
      "Bash(*--remove-label*)",
      "Bash(*--label *)",
      "Bash(gh api *-X *)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(gh api *labels*)",
      "Bash(make run*)",
      "Bash(make supervisor*)",
      "Bash(make drill-trip*)",
      "Bash(make drill-flat*)",
      "Bash(make drill-clean*)",
      "Bash(make kill*)",
      "Bash(make resume*)",
      "Bash(make up*)",
      "Bash(make down*)",
      "Bash(*-m glassbox.supervisor*)",
      "Bash(*-m glassbox.drills round_trip*)",
      "Bash(*-m glassbox.drills flatten*)",
      "Bash(*-m glassbox.drills cleanup*)",
      "Bash(ssh *root@*)",
      "Bash(ssh *glassbox@*)",
      "Bash(sftp *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(sudo *)",
      "Bash(docker *)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\""
          }
        ]
      },
      {
        "matcher": "mcp__alpaca__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_mcp.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_write.py\""
          }
        ]
      }
    ]
  }
}
