# Secrets — never commit. Use .env.example as the template.
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Data & runtime state (regenerated; audit logs stay local)
/data/
*.db
*.sqlite3
/logs/
/audit/
models/*.bin
models/*.txt
models/*.pkl

# Frontend
node_modules/
dist/

# Local tooling
.claude/settings.local.json
.DS_Store
