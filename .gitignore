# Secrets — never commit. Use .env.example as the template.
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Data & runtime state (regenerated; audit logs stay local)
/data/
*.db
*.sqlite3
/logs/
/audit/
models/*.bin
models/*.txt
models/*.pkl

# Frontend
node_modules/
dist/

# Kill switch sentinel — operational state, never committed. Lives at
# data/KILL (covered by /data/ above); this guards any legacy root-level file.
KILL

# Local tooling
.claude/settings.local.json
.DS_Store
local/

# Soak output — the harnesses in soak/ are committed, their results are not
soak-results/
soak/soak-results/

# Generated nightly reports. These are runtime evidence, written to
# data/reports/ (on the persisted volume); the bare reports/ path is the
# pre-move location and is ignored so a stale code path cannot commit output.
/reports/
